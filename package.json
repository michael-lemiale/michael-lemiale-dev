{
  "name": "michael-lemiale-dev",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "svelte-kit sync && vite build",
    "preview": "vite preview",
    "generate:pdfs": "vite preview & echo $! > .preview.pid && sleep 3 && node scripts/generate-cv-pdfs.js; kill $(cat .preview.pid) 2>/dev/null || true; rm -f .preview.pid",
    "deploy": "bun run build && wrangler pages deploy build"
  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.2.7",
    "@fontsource/geist-sans": "^5.2.5",
    "pdf-lib": "^1.17.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sugar-high": "^0.9.5",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "^7.2.8",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.57.1",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tailwindcss/postcss": "^4.2.4",
    "playwright": "^1.59.1",
    "postcss": "^8.5.10",
    "svelte": "^5.55.4",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.9.3",
    "vite": "^6.4.2",
    "wrangler": "^4.84.1"
  }
}
